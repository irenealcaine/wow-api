rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Read-only collections: the n8n workflow writes them with a
    // service account (which bypasses these rules).
    match /characters/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /reputations/{document} {
      allow read: if true;
      allow write: if false;
    }
  }
}